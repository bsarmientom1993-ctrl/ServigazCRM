{
  "name": "servigaz-crm",
  "version": "12.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-build.js",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "node --require ./tests/register.cjs --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:inventory": "node --require ./tests/register.cjs --test tests/inventory.integration.cjs",
    "db:inventory": "node scripts/migrate-inventory.cjs",
    "test:wizard": "node --require ./tests/register.cjs --test tests/work-wizard.integration.cjs",
    "catalogo:ejemplos": "node scripts/configure-example-catalog.cjs",
    "test:agenda": "node --require ./tests/register.cjs --test tests/technician-agenda.integration.cjs",
    "test:clients": "node --require ./tests/register.cjs --test tests/client-history.integration.cjs",
    "test:profiles": "node --require ./tests/register.cjs --test tests/profiles.integration.cjs",
    "test:gas": "node --require ./tests/register.cjs --test tests/gas.integration.cjs",
    "test:catalog": "node --require ./tests/register.cjs --test tests/catalog.integration.cjs",
    "test:store": "node --require ./tests/register.cjs --test tests/store.integration.cjs",
    "test:photos": "node --require ./tests/register.cjs --test tests/photos.integration.cjs",
    "photos:r2": "node scripts/move-photos-to-r2.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
